{
    "name": "babylon-box3d",
    "version": "0.3.0",
    "description": "Box3D physics for Babylon.js: Erin Catto's 3D rigid body engine compiled to WebAssembly plus a physics v2 plugin (Box3DPlugin)",
    "license": "MIT",
    "author": "Andrew Butt",
    "repository": {
        "type": "git",
        "url": "https://github.com/Pryme8/babylon-box3d"
    },
    "keywords": [
        "babylon.js",
        "babylonjs",
        "box3d",
        "physics",
        "wasm",
        "extension"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./wasm": {
            "types": "./lib/esm/box3d.d.ts",
            "default": "./lib/esm/box3d.js"
        },
        "./wasm/node": {
            "types": "./lib/node/box3d.d.ts",
            "default": "./lib/node/box3d.mjs"
        },
        "./lib/*": "./lib/*",
        "./umd/*": "./umd/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "lib",
        "umd",
        "wasm/box3d_shim.c",
        "UPSTREAM_COMMIT",
        "LICENSE",
        "LICENSE-box3d.txt",
        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "npm run build:esm && npm run build:umd",
        "build:esm": "tsc -p tsconfig.json",
        "build:umd": "node scripts/build-umd.mjs",
        "build:wasm": "node wasm/build.mjs",
        "pretest": "npm run build",
        "test": "npm run test:wasm && npm run test:unit",
        "test:wasm": "node test/wasm.smoke.mjs",
        "test:unit": "vitest run",
        "demo": "vite --config demo/vite.config.ts",
        "bench": "node --expose-gc --import tsx bench/node.ts",
        "prepublishOnly": "npm run build && npm test"
    },
    "peerDependencies": {
        "@babylonjs/core": "^8.0.0 || ^9.0.0"
    },
    "devDependencies": {
        "@babylonjs/core": "^9.26.1",
        "@babylonjs/havok": "^1.3.14",
        "esbuild": "^0.25.0",
        "oimo": "^1.0.9",
        "tsx": "^4.23.13",
        "typescript": "^5.6.0",
        "vite": "^6.0.0",
        "vitest": "^3.0.0"
    }
}
