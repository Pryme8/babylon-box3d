+typedef struct b3Manifold b3Manifold;
+
+/// Prototype for a manifold callback.
+/// This is called after a contact's manifolds are computed, mesh and height field contacts included, with all of
+/// them. It may remove points, by moving the points it keeps to the front of a manifold's points and lowering its
+/// pointCount, and remove manifolds the same way, and returns how many manifolds are left. Zero disables the contact
+/// this step. Anchors are relative to originA, the origin of shape A's body.
+/// Notes:
+/// - this function must be thread-safe
+/// - this is only called if one of the two shapes has enabled pre-solve events
+/// - while it is set it replaces the pre-solve callback for these contacts, which still runs for continuous collision
+/// - these contacts are not recycled, so the callback sees every step's manifolds
+/// @warning Do not attempt to modify the world inside this callback
+/// @ingroup world
+typedef int b3ManifoldFcn( b3ShapeId shapeIdA, b3ShapeId shapeIdB, b3Pos originA, b3Manifold* manifolds, int manifoldCount,
+						   void* context );
+
 /// Prototype callback for overlap queries.
 /// Called for each shape found in the query.
 /// @see b3World_OverlapAABB
