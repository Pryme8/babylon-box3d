index 73a363f..84fa8c4 100644
--- a/src/contact.c
+++ b/src/contact.c
@@ -698,7 +698,7 @@ static bool b3UpdateConvexContact( b3World* world, int workerIndex, b3Contact* c
 	b3Vec3 tangentVelocityB = b3RotateVector( xfB.q, materialB->tangentVelocity );
 	contact->tangentVelocity = b3Sub( tangentVelocityA, tangentVelocityB );
 
-	if ( world->preSolveFcn && ( contact->flags & b3_simEnablePreSolveEvents ) != 0 )
+	if ( world->preSolveFcn && world->manifoldFcn == NULL && ( contact->flags & b3_simEnablePreSolveEvents ) != 0 )
 	{
 		b3ShapeId shapeIdA = { shapeA->id + 1, world->worldId, shapeA->generation };
 		b3ShapeId shapeIdB = { shapeB->id + 1, world->worldId, shapeB->generation };
@@ -860,6 +860,43 @@ bool b3UpdateContact( b3World* world, int workerIndex, b3Contact* contact, b3Sha
 		touching = b3UpdateConvexContact( world, workerIndex, contact, shapeA, xfA, shapeB, xfB, flip, arena );
 	}
 
+	if ( touching && world->manifoldFcn != NULL &&
+		 ( ( shapeA->flags & b3_enablePreSolveEvents ) || ( shapeB->flags & b3_enablePreSolveEvents ) ) )
+	{
+		b3ShapeId shapeIdA = { shapeA->id + 1, world->worldId, shapeA->generation };
+		b3ShapeId shapeIdB = { shapeB->id + 1, world->worldId, shapeB->generation };
+
+		// this call assumes thread safety
+		int oldCount = contact->manifoldCount;
+		int count = world->manifoldFcn( shapeIdA, shapeIdB, xfA.p, contact->manifolds, oldCount, world->manifoldContext );
+		count = b3ClampInt( count, 0, oldCount );
+		for ( int i = 0; i < count; ++i )
+		{
+			if ( contact->manifolds[i].pointCount <= 0 )
+			{
+				// a manifold left without points is dropped
+				contact->manifolds[i] = contact->manifolds[count - 1];
+				count -= 1;
+				i -= 1;
+			}
+		}
+
+		if ( count < oldCount )
+		{
+			// manifolds come from allocators sized by their count
+			b3Manifold* manifolds = NULL;
+			if ( count > 0 )
+			{
+				manifolds = b3AllocateManifolds( world, count );
+				memcpy( manifolds, contact->manifolds, count * sizeof( b3Manifold ) );
+			}
+			b3FreeManifolds( world, contact->manifolds, oldCount );
+			contact->manifolds = manifolds;
+			contact->manifoldCount = count;
+			touching = count > 0;
+		}
+	}
+
 	if ( touching )
 	{
 		b3Vec3 centerA = b3RotateVector( xfA.q, localCenterA );
