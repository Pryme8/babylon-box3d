+void b3World_SetManifoldCallback( b3WorldId worldId, b3ManifoldFcn* fcn, void* context )
+{
+	b3World* world = b3GetUnlockedWorldFromId( worldId );
+	if ( world == NULL )
+	{
+		return;
+	}
+	world->manifoldFcn = fcn;
+	world->manifoldContext = context;
+}
