+// Whether a sweep target touches the swept body anywhere. From the first touch their contacts carry the two, crushing
+// or not: swept again, a target the body rides along or presses into would put the whole body back each step.
+static bool b3TargetTouches( b3World* world, const b3Body* target, int bodyId )
+{
+	int contactKey = target->headContactKey;
+	while ( contactKey != B3_NULL_INDEX )
+	{
+		int edgeIndex = contactKey & 1;
+		b3Contact* contact = b3Array_Get( world->contacts, contactKey >> 1 );
+		contactKey = contact->edges[edgeIndex].nextKey;
+		if ( contact->edges[edgeIndex ^ 1].bodyId == bodyId && ( contact->flags & b3_contactTouchingFlag ) )
+		{
+			return true;
+		}
+	}
+	return false;
+}
