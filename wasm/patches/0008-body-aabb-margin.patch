 	body->safetyFactor = def->safetyFactor;
@@ -2516,6 +2517,37 @@ void b3Body_EnableContinuous( b3BodyId bodyId, bool flag )
 	}
 }
 
+void b3Body_SetAabbMargin( b3BodyId bodyId, float margin )
+{
+	B3_ASSERT( b3IsValidFloat( margin ) && margin >= 0.0f );
+
+	b3World* world = b3GetUnlockedWorld( bodyId.world0 );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, BodySetAabbMargin, bodyId, margin );
+
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	body->aabbMargin = margin;
+
+	int shapeId = body->headShapeId;
+	while ( shapeId != B3_NULL_INDEX )
+	{
+		b3Shape* shape = b3Array_Get( world->shapes, shapeId );
+		shape->aabbMargin = b3ComputeShapeMargin( world, shape );
+		shapeId = shape->nextShapeId;
+	}
+}
+
+float b3Body_GetAabbMargin( b3BodyId bodyId )
+{
+	b3World* world = b3GetWorld( bodyId.world0 );
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	return body->aabbMargin;
+}
