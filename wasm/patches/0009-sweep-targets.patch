+typedef struct b3SweepTargetNear
+{
+	b3World* world;
+	bool found;
+} b3SweepTargetNear;
+
+// Stops the query at the first shape of a body that a body swept against sweep targets alone sees
+static bool b3SweepTargetNearCallback( int proxyId, uint64_t userData, void* context )
+{
+	B3_UNUSED( proxyId );
+
+	b3SweepTargetNear* near = context;
+	b3Shape* shape = b3Array_Get( near->world->shapes, (int)userData );
+	b3Body* body = b3Array_Get( near->world->bodies, shape->bodyId );
+	if ( ( body->flags & b3_isSweepTarget ) == 0 || ( body->flags & ( b3_isBullet | b3_sweepTargetsOnly ) ) != 0 )
+	{
+		return true;
+	}
+
+	near->found = true;
+	return false;
+}
+
+// Continuous collision of a body swept against sweep targets alone (b3Body_SetSweepTargetsOnly), once the broad-phase is
+// refit. Finalize left the sweep's start where the step began and gave the body's shapes the bounds of a body that is not
+// fast, so with no hit the body only advances its sweep; a hit puts it back to the time of impact as b3SolveContinuous
+// does, and its shapes take their bounds there.
+static void b3SolveSweepTargets( b3World* world, int bodySimIndex, b3TaskContext* taskContext, float dt )
+{
+	b3TracyCZoneNC( sweep_targets, "Sweep Targets", b3_colorDarkGoldenRod, true );
+
+	b3SolverSet* awakeSet = b3Array_Get( world->solverSets, b3_awakeSet );
+	b3BodySim* fastBodySim = b3Array_Get( awakeSet->bodySims, bodySimIndex );
+	b3Body* fastBody = b3Array_Get( world->bodies, fastBodySim->bodyId );
+
+	b3Pos base = fastBodySim->center0;
+	b3Sweep sweep = b3MakeRelativeSweep( fastBodySim, base );
+
+	b3DynamicTree* kinematicTree = world->broadPhase.trees + b3_kinematicBody;
+	b3DynamicTree* dynamicTree = world->broadPhase.trees + b3_dynamicBody;
+
+	// Every shape lies within the body's farthest extent of its centre, so a box round both ends of the centre's path
+	// holds every shape's sweep. Most steps no target lies in it, and no shape is swept.
+	float reach = b3Length( fastBodySim->maxExtent );
+	b3Vec3 extent = { reach, reach, reach };
+	b3AABB box1 = { b3Sub( sweep.c1, extent ), b3Add( sweep.c1, extent ) };
+	b3AABB box2 = { b3Sub( sweep.c2, extent ), b3Add( sweep.c2, extent ) };
+	b3AABB nearBox = b3OffsetAABB( b3AABB_Union( box1, box2 ), base );
+	b3SweepTargetNear near = { world, false };
+	b3DynamicTree_Query( dynamicTree, nearBox, B3_DEFAULT_MASK_BITS, false, b3SweepTargetNearCallback, &near );
+	if ( near.found == false )
+	{
+		b3DynamicTree_Query( kinematicTree, nearBox, B3_DEFAULT_MASK_BITS, false, b3SweepTargetNearCallback, &near );
+	}
+
+	if ( near.found == false )
+	{
+		fastBodySim->rotation0 = fastBodySim->transform.q;
+		fastBodySim->center0 = fastBodySim->center;
+		b3TracyCZoneEnd( sweep_targets );
+		return;
+	}
+
+	b3Transform xf1;
+	xf1.q = sweep.q1;
+	xf1.p = b3Sub( sweep.c1, b3RotateVector( sweep.q1, sweep.localCenter ) );
+
+	b3Transform xf2;
+	xf2.q = sweep.q2;
+	xf2.p = b3Sub( sweep.c2, b3RotateVector( sweep.q2, sweep.localCenter ) );
+
+	b3ContinuousContext context = { 0 };
+	context.world = world;
+	context.sweep = sweep;
+	context.base = base;
+	context.fastBodySim = fastBodySim;
+	context.fraction = 1.0f;
+	context.candidates = context.localCandidates;
+	context.candidateCapacity = B3_CONTINUOUS_LOCAL_CANDIDATES;
+
+	// Every solid shape is swept however far it moves, since what is thin is the target
+	int shapeId = fastBody->headShapeId;
+	while ( shapeId != B3_NULL_INDEX )
+	{
+		b3Shape* fastShape = b3Array_Get( world->shapes, shapeId );
+		shapeId = fastShape->nextShapeId;
+
+		if ( fastShape->type == b3_meshShape || fastShape->type == b3_heightShape || fastShape->sensorIndex != B3_NULL_INDEX )
+		{
+			continue;
+		}
+
+		context.fastShape = fastShape;
+		context.centroid1 = b3TransformPoint( xf1, fastShape->localCentroid );
+		context.centroid2 = b3TransformPoint( xf2, fastShape->localCentroid );
+
+		b3AABB sweptBox =
+			b3OffsetAABB( b3AABB_Union( b3ComputeShapeAABB( fastShape, xf1 ), b3ComputeShapeAABB( fastShape, xf2 ) ), base );
+		b3DynamicTree_Query( kinematicTree, sweptBox, B3_DEFAULT_MASK_BITS, false, b3ContinuousQueryCallback, &context );
+		b3DynamicTree_Query( dynamicTree, sweptBox, B3_DEFAULT_MASK_BITS, false, b3ContinuousQueryCallback, &context );
+		b3SweepContinuousCandidates( &context );
+	}
+
+	if ( context.candidates != context.localCandidates )
+	{
+		b3Free( context.candidates, context.candidateCapacity * sizeof( b3ContinuousCandidate ) );
+	}
+
+	if ( context.fraction < 1.0f )
+	{
+		// The sweep is relative to the base, so re-add the base to return the advanced pose to world space
+		b3Quat q = b3NLerp( sweep.q1, sweep.q2, context.fraction );
+		b3Vec3 c = b3Lerp( sweep.c1, sweep.c2, context.fraction );
+		b3Vec3 origin = b3Sub( c, b3RotateVector( q, sweep.localCenter ) );
+
+		b3WorldTransform transform = { b3OffsetPos( base, origin ), q };
+		b3Pos center = b3OffsetPos( base, c );
+		fastBodySim->transform = transform;
+		fastBodySim->center = center;
+		fastBodySim->rotation0 = q;
+		fastBodySim->center0 = center;
+		fastBodySim->flags |= b3_hadTimeOfImpact;
+
+		// The time lost loses gravity's share of it, as in b3SolveContinuous
+		b3BodyState* fastBodyState = b3Array_Get( awakeSet->bodyStates, bodySimIndex );
+		float timeLoss = ( 1.0f - context.fraction ) * dt;
+		b3Vec3 dv = b3MulSV( -timeLoss * fastBodySim->gravityScale, world->gravity );
+		dv.x = ( fastBodyState->flags & b3_lockLinearX ) ? 0.0f : dv.x;
+		dv.y = ( fastBodyState->flags & b3_lockLinearY ) ? 0.0f : dv.y;
+		dv.z = ( fastBodyState->flags & b3_lockLinearZ ) ? 0.0f : dv.z;
+		fastBodyState->linearVelocity = b3Add( fastBodyState->linearVelocity, dv );
+
+		b3BodyMoveEvent* event = b3Array_Get( world->bodyMoveEvents, bodySimIndex );
+		event->transform = transform;
+
+		// Finalize bounded the shapes where the step ended. They are bounded again where the body stopped, and their
+		// proxies grow after the sweeps, serially, as a bullet's do.
+		shapeId = fastBody->headShapeId;
+		while ( shapeId != B3_NULL_INDEX )
+		{
+			b3Shape* shape = b3Array_Get( world->shapes, shapeId );
+
+			b3AABB aabb = b3ComputeFatShapeAABB( shape, transform, B3_SPECULATIVE_DISTANCE );
+			shape->aabb = aabb;
+
+			b3AABB* shapeFatAABB = world->fatAABBs.data + shapeId;
+			if ( b3AABB_Contains( *shapeFatAABB, aabb ) == false )
+			{
+				*shapeFatAABB = b3AABB_Inflate( aabb, shape->aabbMargin );
+				fastBodySim->flags |= b3_enlargeBulletBounds;
+			}
+
+			shapeId = shape->nextShapeId;
+		}
+	}
+	else
+	{
+		fastBodySim->rotation0 = fastBodySim->transform.q;
+		fastBodySim->center0 = fastBodySim->center;
+	}
+
+	for ( int i = 0; i < context.sensorCount; ++i )
+	{
+		if ( context.sensorFractions[i] < context.fraction )
+		{
+			b3Array_Push( taskContext->sensorHits, context.sensorHits[i] );
+		}
+	}
+
+	taskContext->distanceIterations = b3MaxInt( taskContext->distanceIterations, context.distanceIterations );
+	taskContext->pushBackIterations = b3MaxInt( taskContext->pushBackIterations, context.pushBackIterations );
+	taskContext->rootIterations = b3MaxInt( taskContext->rootIterations, context.rootIterations );
+
+	b3TracyCZoneEnd( sweep_targets );
+}
