+void b3Body_SetSweepTargetsOnly( b3BodyId bodyId, bool flag )
+{
+	b3World* world = b3GetUnlockedWorld( bodyId.world0 );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, BodySetSweepTargetsOnly, bodyId, flag );
+
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	if ( flag )
+	{
+		body->flags |= b3_sweepTargetsOnly;
+	}
+	else
+	{
+		body->flags &= ~b3_sweepTargetsOnly;
+	}
+
+	b3SyncBodyFlags( world, body );
+}
+
+bool b3Body_IsSweepTargetsOnly( b3BodyId bodyId )
+{
+	b3World* world = b3GetWorld( bodyId.world0 );
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	return ( body->flags & b3_sweepTargetsOnly ) != 0;
+}
+
+void b3Body_SetSweepTarget( b3BodyId bodyId, bool flag )
+{
+	b3World* world = b3GetUnlockedWorld( bodyId.world0 );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, BodySetSweepTarget, bodyId, flag );
+
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	if ( flag )
+	{
+		body->flags |= b3_isSweepTarget;
+	}
+	else
+	{
+		body->flags &= ~b3_isSweepTarget;
+	}
+
+	b3SyncBodyFlags( world, body );
+}
+
+bool b3Body_IsSweepTarget( b3BodyId bodyId )
+{
+	b3World* world = b3GetWorld( bodyId.world0 );
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	return ( body->flags & b3_isSweepTarget ) != 0;
+}
