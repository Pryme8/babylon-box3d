@@ -2384,6 +2384,34 @@ bool b3Body_IsBullet( b3BodyId bodyId )
 	return ( body->flags & b3_isBullet ) != 0;
 }
 
+void b3Body_EnableContinuous( b3BodyId bodyId, bool flag )
+{
+	b3World* world = b3GetUnlockedWorld( bodyId.world0 );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, BodyEnableContinuous, bodyId, flag );
+
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	if ( flag )
+	{
+		body->flags &= ~b3_disableContinuous;
+	}
+	else
+	{
+		body->flags |= b3_disableContinuous;
+	}
+}
+
+bool b3Body_IsContinuousEnabled( b3BodyId bodyId )
+{
+	b3World* world = b3GetWorld( bodyId.world0 );
+	b3Body* body = b3GetBodyFullId( world, bodyId );
+	return ( body->flags & b3_disableContinuous ) == 0;
+}
