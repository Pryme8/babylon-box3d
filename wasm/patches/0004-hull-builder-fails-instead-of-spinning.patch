-static int b3VertexCountOfFace( const b3QHFace* face )
+// Degenerate input, such as a flat or nearly flat point set a few metres from the origin, can leave the
+// half-edge mesh inconsistent: a merge can leave two faces that share every edge, or a face ring that
+// never comes back to where it started, and a walk over either never ends. So every walk that follows
+// the mesh counts its steps here. A ring never has more edges than the pool, so a walk that takes more
+// steps than that is going round forever: the build is marked failed and b3CreateHull returns NULL. A
+// consistent mesh never reaches the limit, so every hull that was built before is built the same.
+static bool b3HullBuilder_Exceeded( b3HullBuilder* b, int* steps )
+{
+	*steps += 1;
+	if ( *steps > b->edgeCapacity )
+	{
+		b->failed = true;
+		return true;
+	}
+	return false;
+}
+
+static int b3VertexCountOfFace( b3HullBuilder* b, const b3QHFace* face )
 {
 	int count = 0;
+	int steps = 0;
 	const b3QHHalfEdge* edge = face->edge;
 	do
 	{
+		if ( b3HullBuilder_Exceeded( b, &steps ) )
+		{
+			break;
+		}
+
 		count++;
 		edge = edge->next;
 	}
