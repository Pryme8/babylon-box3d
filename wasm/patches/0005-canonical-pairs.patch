+	// Each sweep is clipped by the fraction the ones before it found, so the order they run in changes the result in
+	// its last bits. The trees give candidates in an order that depends on their history: they are swept in feature key
+	// order instead. The list starts in localCandidates and moves to the heap if it outgrows them.
+	b3ContinuousCandidate localCandidates[B3_CONTINUOUS_LOCAL_CANDIDATES];
+	b3ContinuousCandidate* candidates;
+	int candidateCount;
+	int candidateCapacity;
 } b3ContinuousContext;
 
+static void b3PushContinuousCandidate( b3ContinuousContext* context, const b3Shape* shape )
+{
+	if ( context->candidateCount == context->candidateCapacity )
+	{
+		int capacity = 2 * context->candidateCapacity;
+		b3ContinuousCandidate* candidates = b3Alloc( capacity * sizeof( b3ContinuousCandidate ) );
+		memcpy( candidates, context->candidates, context->candidateCount * sizeof( b3ContinuousCandidate ) );
+		if ( context->candidates != context->localCandidates )
+		{
+			b3Free( context->candidates, context->candidateCapacity * sizeof( b3ContinuousCandidate ) );
+		}
+		context->candidates = candidates;
+		context->candidateCapacity = capacity;
+	}
+	context->candidates[context->candidateCount] = (b3ContinuousCandidate){ shape->featureKey, shape->id };
+	context->candidateCount += 1;
+}
+
+static int b3CompareContinuousCandidates( const void* a, const void* b )
+{
+	const b3ContinuousCandidate* ca = a;
+	const b3ContinuousCandidate* cb = b;
+	if ( ca->featureKey != cb->featureKey )
+	{
+		return ca->featureKey < cb->featureKey ? -1 : 1;
+	}
+	return ( ca->shapeId > cb->shapeId ) - ( ca->shapeId < cb->shapeId );
+}
