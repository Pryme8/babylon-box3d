+// The pair that makes its contact first: the lower feature key of the shape found, then the lower child, then the
+// lower shape id where keys are equal.
+static bool b3MovePairPrecedes( const b3World* world, const b3MovePair* a, const b3MovePair* b )
+{
+	uint64_t keyA = world->shapes.data[a->shapeIndexA].featureKey;
+	uint64_t keyB = world->shapes.data[b->shapeIndexA].featureKey;
+	if ( keyA != keyB )
+	{
+		return keyA < keyB;
+	}
+	if ( a->childIndex != b->childIndex )
+	{
+		return a->childIndex < b->childIndex;
+	}
+	return a->shapeIndexA < b->shapeIndexA;
+}
+
+// Merge sort of one moved proxy's pair list. Contacts are made in list order, which fixes their ids, and so the order
+// the solver meets them. The trees give pairs in the order of their own shape, which is a function of everything ever
+// inserted into and removed from them, so the list is put in feature key order instead.
+static b3MovePair* b3SortMovePairs( const b3World* world, b3MovePair* list )
+{
+	if ( list == NULL || list->next == NULL )
+	{
+		return list;
+	}
+
+	b3MovePair* slow = list;
+	b3MovePair* fast = list->next;
+	while ( fast != NULL && fast->next != NULL )
+	{
+		slow = slow->next;
+		fast = fast->next->next;
+	}
+	b3MovePair* second = slow->next;
+	slow->next = NULL;
+
+	b3MovePair* a = b3SortMovePairs( world, list );
+	b3MovePair* b = b3SortMovePairs( world, second );
+
+	b3MovePair* head = NULL;
+	b3MovePair** tail = &head;
+	while ( a != NULL && b != NULL )
+	{
+		if ( b3MovePairPrecedes( world, b, a ) )
+		{
+			*tail = b;
+			b = b->next;
+		}
+		else
+		{
+			*tail = a;
+			a = a->next;
+		}
+		tail = &( *tail )->next;
+	}
+	*tail = a != NULL ? a : b;
+	return head;
+}
