+// The order a step's new contacts are made in, which fixes their ids and so the order the solver
+// meets them: the lower feature key of the pair's shapes, then the higher, then the pair key, which
+// is the shape ids and the child index. Shape ids follow the order the world made its shapes in and
+// feature keys do not, so keyed shapes give the same order whatever that order was. Without keys
+// every pair ties on them and the order is the pair key's alone.
+typedef struct b3PairOrder
+{
+	uint64_t lowerFeatureKey;
+	uint64_t upperFeatureKey;
+	uint64_t pairKey;
+} b3PairOrder;
+
+static inline bool b3PairOrderPrecedes( const b3PairOrder* a, const b3PairOrder* b )
+{
+	if ( a->lowerFeatureKey != b->lowerFeatureKey )
+	{
+		return a->lowerFeatureKey < b->lowerFeatureKey;
+	}
+
+	if ( a->upperFeatureKey != b->upperFeatureKey )
+	{
+		return a->upperFeatureKey < b->upperFeatureKey;
+	}
+
+	return a->pairKey < b->pairKey;
+}
