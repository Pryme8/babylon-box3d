+// Moves each of the shape's contacts to the solver path its shapes now call for. A contact in the constraint
+// graph leaves it on its old path and rejoins on the new one, keeping its manifolds and so its warm starting.
+static void b3RouteCrushContacts( b3World* world, b3Shape* shape )
+{
+	b3Body* body = b3Array_Get( world->bodies, shape->bodyId );
+
+	int contactKey = body->headContactKey;
+	while ( contactKey != B3_NULL_INDEX )
+	{
+		int contactId = contactKey >> 1;
+		int edgeIndex = contactKey & 1;
+
+		b3Contact* contact = b3Array_Get( world->contacts, contactId );
+		contactKey = contact->edges[edgeIndex].nextKey;
+
+		if ( contact->shapeIdA != shape->id && contact->shapeIdB != shape->id )
+		{
+			continue;
+		}
+
+		b3Shape* shapeA = b3Array_Get( world->shapes, contact->shapeIdA );
+		b3Shape* shapeB = b3Array_Get( world->shapes, contact->shapeIdB );
+		bool crush = ( ( shapeA->flags | shapeB->flags ) & b3_enableCrush ) != 0;
+		bool wasCrush = ( contact->flags & b3_simCrushContact ) != 0;
+		if ( crush == wasCrush )
+		{
+			continue;
+		}
+
+		if ( contact->colorIndex != B3_NULL_INDEX )
+		{
+			B3_ASSERT( contact->setIndex == b3_awakeSet );
+			bool wasScalar = ( contact->flags & B3_SCALAR_CONTACT_FLAGS ) != 0;
+			b3RemoveContactFromGraph( world, contact->edges[0].bodyId, contact->edges[1].bodyId, contact->colorIndex,
+									  contact->localIndex, wasScalar );
+			contact->flags ^= b3_simCrushContact;
+			b3AddContactToGraph( world, contact );
+		}
+		else
+		{
+			contact->flags ^= b3_simCrushContact;
+		}
+	}
+}
+
+void b3Shape_SetCrushLimit( b3ShapeId shapeId, float maxForce, bool plastic )
+{
+	B3_ASSERT( b3IsValidFloat( maxForce ) );
+	b3World* world = b3GetUnlockedWorld( shapeId.world0 );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, ShapeSetCrushLimit, shapeId, maxForce, plastic );
+
+	b3Shape* shape = b3GetShape( world, shapeId );
+	bool wasCrush = ( shape->flags & b3_enableCrush ) != 0;
+	bool crush = maxForce > 0.0f;
+
+	shape->crushForce = crush ? maxForce : 0.0f;
+	shape->crushPlastic = crush && plastic;
+
+	if ( crush != wasCrush )
+	{
+		shape->flags = crush ? shape->flags | b3_enableCrush : shape->flags & ~b3_enableCrush;
+		b3RouteCrushContacts( world, shape );
+	}
+}
+
+float b3Shape_GetCrushLimit( b3ShapeId shapeId )
+{
+	b3World* world = b3GetWorld( shapeId.world0 );
+	b3Shape* shape = b3GetShape( world, shapeId );
+	return shape->crushForce;
+}
+
+bool b3Shape_IsCrushPlastic( b3ShapeId shapeId )
+{
+	b3World* world = b3GetWorld( shapeId.world0 );
+	b3Shape* shape = b3GetShape( world, shapeId );
+	return shape->crushPlastic;
+}
